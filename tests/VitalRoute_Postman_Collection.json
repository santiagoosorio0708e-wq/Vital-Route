{
	"info": {
		"_postman_id": "c1f7b0a3-a7c8-4775-8025-06c8b9d0abce",
		"name": "VitalRoute - Agente Autónomo API",
		"description": "Suite de pruebas avanzadas para estresar los endpoints del Motor de Decisión, validar concurrencia ACID y comprobar seguridad JWT.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Autorización JWT",
			"item": [
				{
					"name": "Generar Token de Prueba",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"// Guarda automáticamente el token en las variables de entorno de Postman",
									"pm.environment.set(\"jwt_token\", jsonData.access_token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://127.0.0.1:5000/api/v1/auth/generate-test-token",
							"protocol": "http",
							"host": [
								"127",
								"0",
								"0",
								"1"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"auth",
								"generate-test-token"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Simulaciones de Triage (Enrutamiento CDMX)",
			"item": [
				{
					"name": "Emergencia Grave (Hipoxia Extrema)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patient_name\": \"Juan Perez\",\n  \"patient_identifier\": \"MX-12345\",\n  \"symptoms\": \"Dificultad para respirar grave post trauma.\",\n  \"vitals\": {\n    \"heart_rate\": 145,\n    \"systolic_bp\": 85,\n    \"o2_saturation\": 82\n  },\n  \"latitude\": 19.4326,\n  \"longitude\": -99.1332\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:5000/api/v1/triage/route",
							"protocol": "http",
							"host": [
								"127",
								"0",
								"0",
								"1"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"triage",
								"route"
							]
						}
					},
					"response": []
				},
				{
					"name": "Fallo de Seguridad (Sin Token)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"patient_name\": \"Hacker Anónimo\",\n  \"symptoms\": \"Test Seguridad\",\n  \"vitals\": {\n    \"heart_rate\": 80,\n    \"systolic_bp\": 120,\n    \"o2_saturation\": 98\n  },\n  \"latitude\": 19.4326,\n  \"longitude\": -99.1332\n}"
						},
						"url": {
							"raw": "http://127.0.0.1:5000/api/v1/triage/route",
							"protocol": "http",
							"host": [
								"127",
								"0",
								"0",
								"1"
							],
							"port": "5000",
							"path": [
								"api",
								"v1",
								"triage",
								"route"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
