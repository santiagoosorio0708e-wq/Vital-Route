# ==================================================
# VITALROUTE - VARIABLES DE ENTORNO (EJEMPLO)
# ==================================================
# NOTA DE SEGURIDAD:
# Nunca escribas claves de API ni credenciales directamente en el código.
# Copia este archivo a ".env" e ingresa tus valores locales.
# El archivo ".env" será ignorado por Git de forma segura.

# --- BASE DE DATOS (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret_password_here
DB_NAME=vitalroute

# --- NODE.JS API GATEWAY ---
PORT=3000
NODE_ENV=development

# --- PYTHON CORE (Agente / ETL) ---
PYTHON_CORE_URL=http://127.0.0.1:5000

# --- SEGURIDAD Y JWT (NUEVO) ---
# Se utiliza para firmar y verificar que las peticiones provengan de una fuente autorizada
JWT_SECRET_KEY=super_secret_vitalroute_key_2026_xYz
JWT_ALGORITHM=HS256

# --- TIEMPO REAL (PARTE 2: GATEWAY Y CENTRO DE MANDO) ---
# Cifrado AES-256-GCM de las coordenadas que viajan a la tablet del paramédico.
# Genera la tuya con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GPS_ENCRYPTION_KEY=reemplaza_por_64_caracteres_hexadecimales

# Cada cuántos milisegundos se recalcula la posición de la flota
FLEET_TICK_MS=2000

# Simulacro de despacho sin el core de Python. Solo para desarrollo.
ENABLE_DISPATCH_DRILL=false

# --- AGENTE (SPRINT 1: AGENTE END-TO-END) ---
# Gateway del reto: espejo de la API de xAI. La llave se saca del panel
# del concurso y NUNCA se escribe en el codigo ni se sube al repositorio.
RETO_BASE_URL=https://api.reto.pltk.mx/v1
AGENT_API_KEY=pega_aqui_tu_llave_del_panel
RETO_MODEL=grok-4.6

# API Gateway de la Parte 2, donde viven las herramientas del agente
GATEWAY_URL=http://127.0.0.1:3000

# Ruta de despacho. Para ensayar sin el core de Python:
#   AGENT_DISPATCH_PATH=/api/v1/dispatch/drill
AGENT_DISPATCH_PATH=/api/v1/dispatch

# Tope de vueltas del ciclo del agente
AGENT_MAX_STEPS=5

# Modelo falso para probar el ciclo sin gastar credito del reto
AGENT_FAKE_LLM=false
