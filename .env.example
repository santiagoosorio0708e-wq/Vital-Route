# ==================================================
# VITALROUTE - VARIABLES DE ENTORNO (EJEMPLO)
# ==================================================
# NOTA DE SEGURIDAD:
# Nunca escribas claves de API ni credenciales directamente en el código.
# Copia este archivo a ".env" e ingresa tus valores locales.
# El archivo ".env" será ignorado por Git de forma segura.

# --- BASE DE DATOS (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret_password_here
DB_NAME=vitalroute

# --- NODE.JS API GATEWAY ---
PORT=3000
NODE_ENV=development

# --- PYTHON CORE (Agente / ETL) ---
PYTHON_CORE_URL=http://127.0.0.1:5000

# --- SEGURIDAD Y JWT (NUEVO) ---
# Se utiliza para firmar y verificar que las peticiones provengan de una fuente autorizada
JWT_SECRET_KEY=super_secret_vitalroute_key_2026_xYz
JWT_ALGORITHM=HS256
